    "scripts": {
        "start": "concurrently \"yarn watch-css\" \"yarn watch-ar-css\" \"react-scripts start\"",
        "build": "concurrently \"yarn format\" \"yarn build-css\" \"yarn build-ar-css\" \"react-scripts build\"",
        "": "react-scripts ",
        "test": "react-scripts test",
        "eject": "react-scripts eject",
        "lint": "eslint './src/**/*.{js,jsx,ts,tsx}' --max-warnings=0",
        "lint:fix": "eslint './src/**/*.{js,jsx,ts,tsx}' --fix",
        "format": "prettier --write './src/**/*.{js,jsx,ts,tsx}'",
        "watch-css": "sass --watch public/scss/bootstrap.scss:public/css/style.css --source-map",
        "watch-ar-css": "sass --watch public/scssara/bootstrap.scss:public/css/style.ar.css --source-map",
        "build-css": "sass public/scss/bootstrap.scss:public/css/style.css --style compressed",
        "build-ar-css": "sass public/scssara/bootstrap.scss:public/css/style.ar.css --style compressed"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
        "concurrently": "^9.1.0",
        "onchange": "^7.1.0",
        "sass": "^1.81.0"
    },
    "engines": {
        "node": ">=22.6.0",
        "npm": ">=10.8.2"
    }
}
